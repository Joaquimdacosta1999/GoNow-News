{
  "entities": {
    "News": {
      "title": "News Article",
      "description": "A news article published on the GoNow platform.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "category": { "type": "string", "enum": ["Politics", "Football", "Entertainment", "Technology"] },
        "title": { "type": "string" },
        "excerpt": { "type": "string" },
        "content": { "type": "string" },
        "image": { "type": "string", "format": "uri" },
        "date": { "type": "string", "format": "date" },
        "readTime": { "type": "string" },
        "authorUid": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["category", "title", "excerpt", "content", "image", "date", "readTime", "authorUid", "createdAt"]
    },
    "Comment": {
      "title": "Comment",
      "description": "A comment on a news article.",
      "type": "object",
      "properties": {
        "articleId": { "type": "string" },
        "text": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "userEmail": { "type": "string", "format": "email" },
        "userUid": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["articleId", "text", "date", "userUid", "createdAt"]
    },
    "User": {
      "title": "User Profile",
      "description": "User profile information, roles, and preferences.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["admin", "user"] },
        "displayName": { "type": "string" },
        "followedCategories": { 
          "type": "array",
          "items": { "type": "string" }
        },
        "notificationPreferences": {
          "type": "object",
          "properties": {
            "emailAlerts": { "type": "boolean" },
            "browserNotifications": { "type": "boolean" }
          }
        }
      },
      "required": ["uid", "email", "role"]
    },
    "AffiliateAd": {
      "title": "Affiliate Ad",
      "description": "Custom Direct Sponsor Ad or Affiliate Deal used for monetization.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "link": { "type": "string", "format": "uri" },
        "imageUrl": { "type": "string", "format": "uri" },
        "type": { "type": "string", "enum": ["Sponsor", "Affiliate", "Banner"] },
        "views": { "type": "integer" },
        "clicks": { "type": "integer" }
      },
      "required": ["title", "description", "link", "imageUrl", "type"]
    },
    "Poll": {
      "title": "Editorial Poll",
      "description": "An interactive editorial opinion poll.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "question": { "type": "string" },
        "options": {
          "type": "array",
          "items": { "type": "string" }
        },
        "votes": {
          "type": "object"
        }
      },
      "required": ["id", "question", "options", "votes"]
    },
    "PollVote": {
      "title": "Poll Vote",
      "description": "A single user's vote in an editorial poll.",
      "type": "object",
      "properties": {
        "pollId": { "type": "string" },
        "option": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["pollId", "option", "userId", "createdAt"]
    }
  },
  "firestore": {
    "/news/{newsId}": {
      "schema": "News",
      "description": "Collection of news articles."
    },
    "/comments/{commentId}": {
      "schema": "Comment",
      "description": "Collection of comments on articles."
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles and roles."
    },
    "/affiliate_ads/{adId}": {
      "schema": "AffiliateAd",
      "description": "Collection of affiliate products and custom sponsored advertisements."
    },
    "/polls/{pollId}": {
      "schema": "Poll",
      "description": "Opinion polls."
    },
    "/polls/{pollId}/votes/{voteId}": {
      "schema": "PollVote",
      "description": "Individual votes for verification."
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isValidUrl(url) {
      return url is string &&
        (url.matches("^https://.*") || url.matches("^http://.*"));
    }

    // ── News articles ─────────────────────────────────────────────────────────
    // Any signed-in user can publish. Only admin can delete/update.
    match /news/{newsId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
        request.resource.data.title is string && request.resource.data.title.size() > 0 &&
        request.resource.data.excerpt is string && request.resource.data.excerpt.size() > 0 &&
        request.resource.data.content is string && request.resource.data.content.size() > 0 &&
        request.resource.data.category in ['Politics', 'Football', 'Entertainment', 'Technology'] &&
        isValidUrl(request.resource.data.image) &&
        request.resource.data.date is string &&
        request.resource.data.readTime is string &&
        request.resource.data.authorUid == request.auth.uid &&
        request.resource.data.createdAt is timestamp;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Comments ──────────────────────────────────────────────────────────────
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
        request.resource.data.articleId is string &&
        request.resource.data.text is string && request.resource.data.text.size() > 0 &&
        request.resource.data.text.size() <= 1000 &&
        request.resource.data.userUid == request.auth.uid;
      allow delete: if isAuthenticated() &&
        (request.auth.uid == resource.data.userUid || isAdmin());
    }

    // ── Users ─────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAdmin() || request.auth.uid == userId;
    }

    // ── Test connection ───────────────────────────────────────────────────────
    match /test/{docId} {
      allow read: if true;
    }
  }
}
